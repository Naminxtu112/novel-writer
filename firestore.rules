rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ユーザー情報
    match /users/{userId} {
      allow read, write:
        if signedIn()
        && request.auth.uid == userId;
    }

    // 作品
    match /novels/{novelId} {

      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read, update, delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid;

      // 章
      match /chapters/{chapterId} {

        // 新規作品と第1章を同じbatchで作る場合
        allow create:
          if signedIn()
          && getAfter(
            /databases/$(database)/documents/novels/$(novelId)
          ).data.ownerId == request.auth.uid;

        allow read, update, delete:
          if signedIn()
          && get(
            /databases/$(database)/documents/novels/$(novelId)
          ).data.ownerId == request.auth.uid;
      }
    }

    // URL slug
    match /slugs/{slugKey} {

      // app.jsが「このslugは既に存在するか」を
      // getDoc()で確認するため必要
      //
      // list（一覧取得）は許可しない
      allow get:
        if signedIn();

      allow list:
        if false;

      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update:
        if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
