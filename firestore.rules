rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsNovel(novelId) {
      return signedIn()
        && get(/databases/$(database)/documents/novels/$(novelId))
             .data.ownerId == request.auth.uid;
    }

    function ownsNovelAfter(novelId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/novels/$(novelId))
             .data.ownerId == request.auth.uid;
    }

    // ユーザー情報
    match /users/{userId} {
      allow read, write:
        if signedIn() && request.auth.uid == userId;
    }

    // 作品
    match /novels/{novelId} {

      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read, update, delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid;

      // 章
      match /chapters/{chapterId} {

        allow read:
          if ownsNovel(novelId);

        // 新規作品と第1章を同じbatchで作る場合にも対応
        allow create:
          if ownsNovelAfter(novelId);

        allow update, delete:
          if ownsNovel(novelId);
      }
    }

    // 作品URL
    match /slugs/{slugKey} {

      /*
       * 重要:
       * 新規作品作成前に getDoc(slugRef) で
       * slugの重複確認をしている。
       *
       * 存在しないdocumentにも get を許可しないと
       * exists() を確認する前に
       * Missing or insufficient permissions になる。
       */
      allow get:
        if signedIn();

      // collection全体の取得は禁止
      allow list:
        if false;

      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
